// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ============================================
// AUTHENTICATION
// ============================================

model Pin {
  id        String   @id @default(cuid())
  pinNumber String   @unique // 4-digit PIN
  role      PinRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinNumber])
}

enum PinRole {
  ADMIN             // PIN 1: Full access
  EXPENSE_INVENTORY // PIN 2: Expenses + Inventory
  INVENTORY_ONLY    // PIN 3: Inventory only
}

// ============================================
// INVENTORY MODULE
// ============================================

model InventoryTransaction {
  id           String     @id @default(cuid())
  date         DateTime
  warehouse    Warehouse
  bucketType   BucketType
  action       ActionType
  quantity     Int        // Signed: negative for Sell, positive for Stock
  buyerSeller  String
  runningTotal Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([date])
  @@index([warehouse])
  @@index([bucketType])
  @@index([buyerSeller])
}

enum Warehouse {
  PALLAVI
  TULARAM
  FACTORY
}

enum BucketType {
  TATA_G
  TATA_W
  TATA_HP
  AL_10_LTR
  AL
  BB
  ES
  MH
  MH_10_LTR
  TATA_10_LTR
  IBC_TANK
  AP_BLUE
  INDIAN_OIL_20L
  FREE_DEF
}

enum ActionType {
  STOCK
  SELL
}

// ============================================
// STOCK TRACKING MODULE
// ============================================

model StockTransaction {
  id              String               @id @default(cuid())
  date            DateTime
  type            StockTransactionType
  category        StockCategory
  quantity        Float                // Can be negative for consumption
  unit            StockUnit
  description     String?
  runningTotal    Float
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([date])
  @@index([type])
  @@index([category])
}

enum StockTransactionType {
  ADD_UREA       // Adding raw material
  PRODUCE_BATCH  // Production: Urea → Free DEF
  SELL_FREE_DEF  // Selling loose DEF
  FILL_BUCKETS   // Auto: when STOCK bucket in inventory
  SELL_BUCKETS   // Auto: when SELL bucket in inventory
}

enum StockCategory {
  UREA           // Raw material
  FREE_DEF       // Finished goods (loose)
  FINISHED_GOODS // Total finished (Free DEF + Buckets)
}

enum StockUnit {
  KG
  LITERS
  BAGS
}

// ============================================
// EXPENSE MODULE
// ============================================

model ExpenseTransaction {
  id        String          @id @default(cuid())
  date      DateTime
  amount    Decimal         @db.Decimal(12, 2) // Up to 99,99,99,999.99
  account   ExpenseAccount
  type      TransactionType
  name      String          // Vendor/Customer name
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([date])
  @@index([account])
  @@index([type])
  @@index([name])
}

enum ExpenseAccount {
  CASH
  PRASHANT_GAYDHANE
  PMR
  KPG_SAVING
  KP_ENTERPRISES
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ============================================
// BACKUP LOGS
// ============================================

model BackupLog {
  id             String   @id @default(cuid())
  backupDate     DateTime @default(now())
  backupType     String   // "MANUAL" or "AUTOMATIC"
  driveFileId    String?  // Google Drive file ID
  inventoryCount Int
  expenseCount   Int
  stockCount     Int      @default(0)
  leadsCount     Int      @default(0)
  status         String   // "SUCCESS" or "FAILED"
  errorMessage   String?

  @@index([backupDate])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// PAGARBOOK MODULE (Employee + Attendance + Payroll)
// Tables created via prisma/sql/pagarbook.sql in Supabase SQL editor.
// Schema mirrored here so Prisma Client has types — do NOT run prisma migrate.
// ============================================

model Employee {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique
  pin              String   // 4-digit, plaintext
  monthlySalary    Decimal  @db.Decimal(12, 2)
  openingBalance   Decimal  @default(0) @db.Decimal(12, 2) // migration: positive = owed, negative = advance
  joinedDate       DateTime @default(now())
  active           Boolean  @default(true)
  faceDescriptors  Json?    // array of 128-float arrays (per descriptor)
  pushSubscription Json?    // single subscription object, last-device-wins
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  attendance       AttendanceRecord[]
  salaryPayments   SalaryPayment[]

  @@index([phone])
  @@index([active])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         // IST 00:00 UTC of that day
  markedAt    DateTime         @default(now())
  status      AttendanceStatus
  source      AttendanceSource
  approved    Boolean          @default(false)
  approvedAt  DateTime?
  modified    Boolean          @default(false)
  modifiedAt  DateTime?
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([approved])
}

model SalaryPayment {
  id               String              @id @default(cuid())
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id])
  type             SalaryPaymentType   @default(REGULAR)
  periodStart      DateTime
  periodEnd        DateTime
  daysInMonth      Int
  daysAttended     Int
  monthlySalary    Decimal             @db.Decimal(12, 2) // snapshot
  calculatedAmount Decimal             @db.Decimal(12, 2) // system-suggested
  amountPaid       Decimal             @db.Decimal(12, 2) // admin-typed (can be negative)
  paidDate         DateTime            @default(now())
  account          ExpenseAccount      @default(CASH)
  expenseId        String?
  notes            String?
  createdAt        DateTime            @default(now())

  @@index([paidDate])
  @@index([employeeId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceSource {
  FACE_SCAN
  ADMIN_MANUAL
  EMPLOYEE_SELF
}

enum SalaryPaymentType {
  REGULAR
  ADVANCE
  ADJUSTMENT
}

// ============================================
// LEADS MODULE
// ============================================

model Lead {
  id               String       @id @default(cuid())

  // Basic Info
  name             String
  phone            String
  whatsappNumber   String?      // If different from phone
  countryCode      String       @default("91") // Default India
  company          String?

  // Inquiry Classification
  inquiryType      InquiryType  @default(PRODUCT_DETAILS)

  // Status Tracking
  status           LeadStatus   @default(NEW)

  // Call Tracking
  lastCallDate     DateTime?
  callOutcome      CallOutcome?

  // Follow-up Scheduling
  nextActionType   NextActionType?
  nextActionDate   DateTime?

  // Factory Visit Tracking
  visitDate        DateTime?
  visitStatus      VisitStatus?
  visitOutcome     VisitOutcome?
  visitNotes       String?

  // Dead Lead Tracking
  deadReason       DeadLeadReason?

  // Notes
  notes            String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([inquiryType])
  @@index([nextActionDate])
  @@index([visitDate])
  @@index([lastCallDate])
}

enum InquiryType {
  PRODUCT_DETAILS  // Replied 1 - wants product info
  FACTORY_SETUP    // Replied 2 - wants factory setup info
  GENERAL_CALL     // Replied 3 - just wants a call
}

enum LeadStatus {
  // Active Statuses
  NEW                    // Just came in from WhatsApp
  CONTACTED              // We've reached out (called/messaged)
  INTERESTED             // Genuine, following up
  VISIT_SCHEDULED        // Factory visit planned
  CONVERTED              // Deal done!

  // Dead Status
  DEAD                   // Not interested / Wrong number / Spam
}

enum CallOutcome {
  INTERESTED             // Genuine, wants to proceed
  NEEDS_MORE_INFO        // Genuine, needs details first
  CALL_BACK_LATER        // Asked to call again
  TALK_TO_BOSS           // Decision maker not available
  NOT_GENUINE            // Fake/spam inquiry
  WRONG_NUMBER           // Invalid contact
  NO_ANSWER              // Didn't pick up
  BUSY                   // Said they're busy
}

enum NextActionType {
  CALL                   // Need to call
  SEND_DETAILS           // Send product info
  SCHEDULE_OWNER_CALL    // Arrange call with owner
  SCHEDULE_VISIT         // Arrange factory visit
  FOLLOW_UP_CALL         // Follow up after details sent
  SEND_QUOTE             // Send pricing
}

enum VisitStatus {
  SCHEDULED              // Visit is scheduled
  RESCHEDULED            // Visit was rescheduled
  COMPLETED              // Visit happened
  NO_SHOW                // They didn't come
  CANCELLED              // Visit cancelled
}

enum VisitOutcome {
  VERY_INTERESTED        // Going to buy
  INTERESTED             // Likely to buy
  NEEDS_TIME             // Thinking about it
  NOT_INTERESTED         // Won't buy
}

enum DeadLeadReason {
  NOT_INTERESTED         // Confirmed not interested
  WRONG_NUMBER           // Invalid number
  SPAM                   // Spam/fake inquiry
  CLICKED_BY_MISTAKE     // Accidental click
  COMPETITOR             // Competitor inquiry
  ALREADY_HAS_SUPPLIER   // Has existing supplier
}

// Remove old Priority enum as it's no longer needed
