# Database - Supabase PostgreSQL
# Pooled connection (for application runtime)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"

# Direct connection (for migrations and schema operations)
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Authentication
JWT_SECRET="your-secret-key-here-min-32-chars"

# Google Drive API (for backups)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"
