# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication
JWT_SECRET="your-secret-key-here-min-32-chars"

# Google Drive API (for automatic backups)
# IMPORTANT: Backups will fail if these are not properly configured
# See GOOGLE_DRIVE_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=""                    # Your OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_SECRET=""                # Your OAuth 2.0 Client Secret
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"  # Update for production
GOOGLE_REFRESH_TOKEN=""                # Generate using OAuth 2.0 Playground or script
GOOGLE_DRIVE_FOLDER_ID=""              # The folder ID where backups will be stored
